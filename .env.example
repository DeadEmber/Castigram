# Copia este fichero a .env.local y rellena con los datos de tu proyecto Supabase.
# Los encuentras en: Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Nombre del pueblo (aparece en la cabecera). Opcional.
NEXT_PUBLIC_PUEBLO=Mi Pueblo
